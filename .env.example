# ==============================================================================
# TikdiSMP Bot - Production Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# Discord Bot Credentials & Gateway Configuration
# ------------------------------------------------------------------------------
DISCORD_BOT_TOKEN="your_discord_bot_token_here"
DISCORD_CLIENT_ID="123456789012345678"
# Optional: Set GUILD_ID to register slash commands instantly to a single guild.
# Leave empty or omit to register slash commands globally across all guilds.
DISCORD_GUILD_ID=""
# The text channel where status embeds, logs, and interactive controls are posted.
CONTROL_CHANNEL_ID="123456789012345678"

# ------------------------------------------------------------------------------
# Aternos Account & Target Server
# ------------------------------------------------------------------------------
ATERNOS_USERNAME="your_aternos_username"
ATERNOS_PASSWORD="your_aternos_password"
# The exact URL of your Aternos server (e.g., https://aternos.org/server/ or with your server hash)
ATERNOS_SERVER_URL="https://aternos.org/server/"
# Optional: Pre-authenticated ATERNOS_SESSION cookie if bypassing initial login prompt
ATERNOS_SESSION=""

# ------------------------------------------------------------------------------
# Minecraft Server Ping & Protocol Telemetry
# ------------------------------------------------------------------------------
MC_SERVER_ADDRESS="your_server.aternos.me"
MC_SERVER_PORT="25565"
MC_PING_TIMEOUT_MS="8000"
MC_FAILURE_THRESHOLD="2"
# Server branding / display metadata
MC_VERSION="Paper 1.20.4"
MC_SOFTWARE="Paper"
MC_RAM="2048 MB"
MC_REGION="Europe"

# ------------------------------------------------------------------------------
# Role-Based Access Control (Discord Snowflake IDs - comma separated)
# ------------------------------------------------------------------------------
# Owner: Full permission to execute /restart, /stop, /start, /status, /ping, etc.
OWNER_USER_IDS=""
# Admin: Allowed to /stop, /start, /status, /players
ADMIN_USER_IDS=""
ADMIN_ROLE_IDS=""
# Minecraft Role: Can execute all commands EXCEPT /restart
MINECRAFT_ROLE_IDS=""
# Trusted: Can execute /start, /status, /players, /ping
TRUSTED_USER_IDS=""
TRUSTED_ROLE_IDS=""

# ------------------------------------------------------------------------------
# Web Dashboard & Telemetry API
# ------------------------------------------------------------------------------
WEB_ENABLED="true"
WEB_HOST="0.0.0.0"
PORT="5176"
# Strong admin password for dashboard actions (e.g. starting/stopping server, viewing raw logs)
DASHBOARD_ADMIN_PASSWORD="change_this_to_a_secure_password"
# Allow /api/members to query guild members (requires Discord Server Members Intent)
WEB_EXPOSE_MEMBERS="true"

# ------------------------------------------------------------------------------
# Browser Automation & Hardware Optimization (VPS / Termux / Home Cloud)
# ------------------------------------------------------------------------------
# Headless mode: true by default. On Termux with Xvfb, can be set to false.
PUPPETEER_HEADLESS="true"
# Custom Chromium executable path (required on Termux / ARM64 or custom Linux paths):
# Termux example: /data/data/com.termux/files/usr/bin/chromium-browser
# Debian/Ubuntu VPS example: /usr/bin/chromium-browser
# PUPPETEER_EXECUTABLE_PATH=""
# Additional Chromium arguments (comma-separated):
# PUPPETEER_EXTRA_ARGS=""
# Optional custom user data directory for persistent browser profile
# SESSION_DIR="./data/browser-session"

# ------------------------------------------------------------------------------
# Polling & Self-Healing Watchdogs
# ------------------------------------------------------------------------------
POLL_INTERVAL_SECONDS="45"
QUEUE_POLL_INTERVAL_SECONDS="120"
LAUNCH_POLL_INTERVAL_SECONDS="10"
LAUNCH_WATCH_TIMEOUT_MINUTES="45"
QUEUE_STUCK_MINUTES="10"
MAX_QUEUE_RESTARTS="2"

# ------------------------------------------------------------------------------
# Self-Service Registration & General Settings
# ------------------------------------------------------------------------------
REGISTRATION_ENABLED="false"
TIMEZONE="UTC"
LOG_LEVEL="info"
LOG_TO_FILE="true"
